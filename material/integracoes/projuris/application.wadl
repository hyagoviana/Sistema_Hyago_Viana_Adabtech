          </wadl:representation>
          <wadl:param name="token" style="query">
            <wadl:doc><![CDATA[Token de autenticação (query param obrigatório)]]></wadl:doc>
          </wadl:param>
        </wadl:request>
        <wadl:response>
          <wadl:doc><![CDATA[Response HTTP 200 em caso de sucesso, 401 em caso de token inválido]]></wadl:doc>
          <wadl:representation mediaType="application/json"/>
        </wadl:response>
      </wadl:method>
    </wadl:resource>

