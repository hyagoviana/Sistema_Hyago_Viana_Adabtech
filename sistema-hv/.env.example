# ============================================================================
# Sistema HV — Template de variáveis de ambiente
# ----------------------------------------------------------------------------
# Copie este arquivo para .env.local e preencha os valores reais.
# .env.local está coberto por *.local no .gitignore — não comita.
#
# Variáveis com prefixo VITE_ são expostas no bundle client.
# NUNCA coloque secrets server-side em variáveis VITE_*.
# ============================================================================

# Ambiente
NODE_ENV=development
APP_ENV=staging
APP_URL=http://localhost:8080
PORTAL_URL=http://localhost:8080/portal

# Sprint 1 — Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Sprint 1 — Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Sprint 1 — Hetzner Cloud
HETZNER_API_TOKEN=
HETZNER_VPS_IP=
HETZNER_SSH_USER=root
HETZNER_SSH_KEY_PATH=~/.ssh/hv-hetzner

# Sprint 1 — Sentry
VITE_SENTRY_DSN_FRONT=
SENTRY_DSN_EDGE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=hyago-viana-advocacia
SENTRY_PROJECT_FRONT=sistema-hv-front
SENTRY_PROJECT_EDGE=sistema-hv-edge

# Sprint 1 — PostHog
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_API_KEY=

# Sprint 1 — Logtail (Better Stack)
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGESTING_HOST=in.logs.betterstack.com

# Sprint 1 — UptimeRobot
UPTIMEROBOT_API_KEY=

# Sprint 1 — GitHub
GITHUB_PAT=
GITHUB_REPO=

# Sprint 6 — Postmark
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_FROM_NAME=

# Sprint 6 — ZapSign
ZAPSIGN_API_TOKEN=
ZAPSIGN_HMAC_SECRET=
ZAPSIGN_WEBHOOK_URL=

# Sprint 5/6 — Google Workspace (Gmail + Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GMAIL_SENDER_ADDRESS=

# Sprint 9 — Conta Azul (alternativa A — ADR-013)
CONTA_AZUL_CLIENT_ID=
CONTA_AZUL_CLIENT_SECRET=
CONTA_AZUL_ACCESS_TOKEN=
CONTA_AZUL_REFRESH_TOKEN=

# Sprint 9 — Asaas (alternativa B — ADR-013)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=sandbox

# Sprint 9 — ChatGuru (WhatsApp)
CHATGURU_API_TOKEN=
CHATGURU_ACCOUNT_ID=
CHATGURU_PHONE_ID=
CHATGURU_WEBHOOK_SECRET=

# Sprint 9 — 2FA SMS (ADR-008: Twilio vs Zenvia)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ZENVIA_API_TOKEN=
ZENVIA_FROM_NUMBER=

# Sprint 7 — Gov.br + SEI (uso na VPS Hetzner, via Playwright)
GOVBR_CPF=
GOVBR_PASSWORD=
GOVBR_2FA_SEED=
SEI_BASE_URL=https://sei.mec.gov.br

# Sprint 1 — n8n self-hosted
N8N_BASE_URL=
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# Criptografia / Segurança (gere com: openssl rand -hex 32)
ENCRYPTION_KEY=
HMAC_SECRET=
SESSION_SECRET=
