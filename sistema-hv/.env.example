# ============================================================================
# Sistema HV — Template de variáveis de ambiente
# ----------------------------------------------------------------------------
# Copie para .env.local e preencha. .env.local é gitignored.
# Variáveis com prefixo VITE_ vão para o bundle do navegador — não colocar
# secrets server-side nelas.
# ============================================================================

# Ambiente
# IMPORTANTE: NÃO defina NODE_ENV aqui! O Vite gerencia automaticamente:
# - vite dev  → NODE_ENV=development
# - vite build → NODE_ENV=production
# Setar NODE_ENV=development no .env quebra o build de produção (jsxDEV error).
APP_ENV=staging
# APP_URL — base usada nos links dos e-mails de convite/redefinição de senha
# (redirectTo → /definir-senha). Em dev: http://localhost:8080.
# Em produção (Vercel) configure: APP_URL=https://www.sistemahyagoviana.com.br
# Sem isso, o link cai no fallback do código (domínio oficial), mas mantenha
# alinhado com o "Site URL" + "Redirect URLs" do Supabase Auth.
APP_URL=http://localhost:8080

# Supabase (banco + auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# GitHub (CLI local / scripts)
GITHUB_PAT=
GITHUB_REPO=

# Google Drive (Service Account — storage de arquivos dos clientes)
GOOGLE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Google Docs (OAuth da conta-sistema — motor de GERAÇÃO de documentos do caso)
# OBRIGATÓRIO p/ "Gerar documento" funcionar (copiar modelo, substituir
# placeholders, link-editável). A FALTA destas três é a causa nº 1 do 502 ao
# gerar documento. Configure-as TAMBÉM na Vercel (Project Settings → Environment).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Kill-switch do onboarding automático via n8n (rota /api/webhooks/n8n).
# O cadastro de clientes/casos é MANUAL pelo sistema. Ausente ou != "true" ⇒
# DESATIVADO: o endpoint responde 403 e NÃO cria nada. Defina "true" só se
# quiser reativar o intake automático do n8n.
N8N_INTAKE_ENABLED=false

# (Adicionar quando entrar em uso)
# N8N_WEBHOOK_BASE_URL=
# N8N_WEBHOOK_SECRET=
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# SESSION_SECRET=
# ENCRYPTION_KEY=
