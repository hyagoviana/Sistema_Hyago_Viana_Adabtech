      "parameters": {
        "jsCode": "// Unificar dados: pegar dados parseados + possivel anexo do Get Message\nconst emailData = $('Extrair Dados do Email').item.json;\nlet binary = null;\nlet attachment_filename = emailData.attachment_filename || emailData.doc_nome || 'documento.pdf';\n\n// Checar se veio binary do Gmail Trigger ou do Get Message\ntry {\n  const triggerItem = $('Gmail Trigger').item;\n  if (triggerItem.binary && Object.keys(triggerItem.binary).length > 0) {\n    binary = triggerItem.binary;\n    const key = Object.keys(binary)[0];\n    attachment_filename = binary[key].fileName || attachment_filename;\n  }\n} catch(e) {}\n\ntry {\n  const getMessage = $('Buscar Email Completo').item;\n  if (getMessage.binary && Object.keys(getMessage.binary).length > 0) {\n    binary = getMessage.binary;\n    const key = Object.keys(binary)[0];\n    attachment_filename = binary[key].fileName || attachment_filename;\n  }\n} catch(e) {}\n\nconst result = {\n  json: {\n    ...emailData,\n    attachment_filename,\n    has_binary: binary !== null\n  }\n};\n\nif (binary) result.binary = binary;\n\nreturn [result];"
      },
