    {
      "parameters": {
        "jsCode": "// Parsear comprovante de assinatura do Zaping\n// Formato: \"Comprovante de assinatura NOME - TIPO assinou o documento NOME - CONTRATO - TIPO.pdf\"\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const subject = (item.json.subject || '').trim();\n  const body = (item.json.text || item.json.snippet || '').trim();\n  const fullText = subject + ' ' + body;\n  const messageId = item.json.id || item.json.messageId || '';\n\n  // --- EXTRAIR NOME DO CLIENTE ---\n  let nome_cliente = '';\n  // Tenta: \"Comprovante de assinatura NOME - TIPO\"\n  const compMatch = fullText.match(/[Cc]omprovante de assinatura\\s+([A-Z\\u00C0-\\u017F\\s]+?)\\s*-\\s*/i);\n  if (compMatch) {\n    nome_cliente = compMatch[1].trim();\n  }\n  // Fallback: \"NOME assinou o documento\"\n  if (!nome_cliente) {\n    const assMatch = fullText.match(/([A-Z\\u00C0-\\u017F][A-Z\\u00C0-\\u017F\\s]+?)\\s+assinou/i);\n    if (assMatch) nome_cliente = assMatch[1].trim();\n  }\n\n  // --- EXTRAIR NOME DO DOCUMENTO ---\n  let doc_nome = '';\n  const docMatch = fullText.match(/assinou o documento\\s+(.+?\\.pdf)/i);\n  if (docMatch) {\n    doc_nome = docMatch[1].trim();\n  }\n\n  // --- EXTRAIR TIPO DE PROCESSO ---\n  let tipo_processo = 'FIES_ESF'; // default\n  const tipoMap = {\n    'desenrola fies': 'FIES_ESF',\n    'fies esf': 'FIES_ESF',\n    'fies dgm': 'FIES_DGM',\n    'covid': 'COVID',\n    'mais medicos': 'MAIS_MEDICOS',\n    'mais m\\u00e9dicos': 'MAIS_MEDICOS',\n    'residencia': 'RESIDENCIA',\n    'resid\\u00eancia': 'RESIDENCIA',\n    'cfm': 'CFM_CRM',\n    'crm': 'CFM_CRM'\n  };\n  const textLower = fullText.toLowerCase();\n  for (const [key, val] of Object.entries(tipoMap)) {\n    if (textLower.includes(key)) {\n      tipo_processo = val;\n      break;\n    }\n  }\n\n  // --- EXTRAIR CPF/CNPJ (se presente no body) ---\n  const cpfMatch = fullText.match(/(\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2})|(\\d{2}\\.?\\d{3}\\.?\\d{3}\\/?\\d{4}-?\\d{2})/);\n  const cpf_cnpj = cpfMatch ? cpfMatch[0].replace(/[^\\d]/g, '') : '';\n\n  // --- EXTRAIR EMAIL ---\n  const emailMatch = fullText.match(/(?:e-?mail)[:\\s]*([\\w.+-]+@[\\w.-]+\\.[a-z]{2,})/i);\n  const email = emailMatch ? emailMatch[1] : '';\n\n  // --- EXTRAIR TELEFONE ---\n  const phoneMatch = fullText.match(/(?:tel|telefone|fone|whatsapp|celular)[:\\s]*(\\(?\\d{2}\\)?\\s?\\d{4,5}-?\\d{4})/i);\n  const telefone = phoneMatch ? phoneMatch[1].replace(/[^\\d]/g, '') : '';\n\n  // --- VERIFICAR SE TEM ANEXO ---\n  const payload = item.json.payload || {};\n  const parts = payload.parts || [];\n  let tem_anexo = false;\n  let attachment_id = '';\n  let attachment_filename = '';\n  let attachment_mime = '';\n\n  function findAttachment(partsList) {\n    for (const part of partsList) {\n      if (part.filename && part.filename.length > 0 && part.body && part.body.attachmentId) {\n        tem_anexo = true;\n        attachment_id = part.body.attachmentId;\n        attachment_filename = part.filename;\n        attachment_mime = part.mimeType || 'application/pdf';\n        return;\n      }\n      if (part.parts) findAttachment(part.parts);\n    }\n  }\n  findAttachment(parts);\n\n  // Tambem checar binary data do n8n\n  if (!tem_anexo && item.binary) {\n    const binKeys = Object.keys(item.binary);\n    if (binKeys.length > 0) {\n      tem_anexo = true;\n      attachment_filename = item.binary[binKeys[0]].fileName || doc_nome || 'documento.pdf';\n      attachment_mime = item.binary[binKeys[0]].mimeType || 'application/pdf';\n    }\n  }\n\n  results.push({\n    json: {\n      nome_cliente,\n      cpf_cnpj,\n      email,\n      telefone,\n      tipo_processo,\n      doc_nome,\n      tem_anexo,\n      attachment_id,\n      attachment_filename,\n      attachment_mime,\n      message_id: messageId,\n      email_subject: subject,\n      raw_body: body\n    }\n  });\n}\n\nreturn results;"
      },
