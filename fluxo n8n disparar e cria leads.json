      "parameters": {
        "jsCode": "// Montar dados para criar o caso\n// Pegar dados de onde vieram (email direto ou extraido do PDF)\nlet emailData;\ntry { emailData = $('Extrair Dados do PDF').item.json; } catch(e) {}\nif (!emailData || !emailData.cpf_cnpj) {\n  emailData = $('Unificar Dados + Anexo').item.json;\n}\n\nlet client_id = '';\nlet drive_folder_id = '';\n\ntry {\n  const existing = $('Cliente Existe?').item.json;\n  if (existing && existing.id) {\n    client_id = existing.id;\n    drive_folder_id = existing.drive_folder_id || '';\n  }\n} catch(e) {}\n\nif (!client_id) {\n  try {\n    const created = $('Salvar Pasta no Cliente').item.json;\n    if (created && created.id) {\n      client_id = created.id;\n      drive_folder_id = created.drive_folder_id || '';\n    }\n  } catch(e) {}\n}\n\nif (!client_id) {\n  try {\n    const created2 = $('Criar Cliente').item.json;\n    if (created2 && created2.id) {\n      client_id = created2.id;\n    }\n  } catch(e) {}\n}\n\n// Se criou pasta agora, pegar do node Criar Pasta Cliente\nif (!drive_folder_id) {\n  try {\n    const folder = $('Criar Pasta Cliente').item.json;\n    if (folder && folder.id) drive_folder_id = folder.id;\n  } catch(e) {}\n}\n\nconst tipoShort = emailData.tipo_processo.split('_')[0];\nconst year = new Date().getFullYear();\nconst seq = String(Date.now()).slice(-4);\nconst case_code = 'HV-' + tipoShort + '-' + year + '-' + seq;\n\nreturn [{\n  json: {\n    client_id,\n    drive_folder_id,\n    case_code,\n    case_type: emailData.tipo_processo,\n    municipio: emailData.municipio || null,\n    nome_cliente: emailData.nome_cliente,\n    doc_nome: emailData.doc_nome,\n    has_binary: emailData.has_binary || false\n  }\n}];"
