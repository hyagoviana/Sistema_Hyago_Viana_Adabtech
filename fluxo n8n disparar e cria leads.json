      "id": "extract-pdf-text",
      "name": "Extrair Texto do PDF"
    },
    {
      "parameters": {
        "jsCode": "// Extrair dados do cliente a partir do texto do PDF\nconst emailData = $('Unificar Dados + Anexo').item.json;\nconst pdfText = $input.item.json.data || $input.item.json.text || \"\";\n\n// --- CPF/CNPJ ---\nlet cpf_cnpj = emailData.cpf_cnpj || \"\";\nif (!cpf_cnpj) {\n  const cpfFmt = pdfText.match(/\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}/);\n  if (cpfFmt) {\n    cpf_cnpj = cpfFmt[0].replace(/[^\\d]/g, \"\");\n  }\n}\nif (!cpf_cnpj) {\n  const cnpjFmt = pdfText.match(/\\d{2}\\.\\d{3}\\.\\d{3}\\/\\d{4}-\\d{2}/);\n  if (cnpjFmt) {\n    cpf_cnpj = cnpjFmt[0].replace(/[^\\d]/g, \"\");\n  }\n}\nif (!cpf_cnpj) {\n  const seqs = pdfText.match(/\\b\\d{11}\\b/g) || [];\n  for (const seq of seqs) {\n    if (!/^(\\d)\\1{10}$/.test(seq)) {\n      cpf_cnpj = seq;\n      break;\n    }\n  }\n}\n\n// --- TELEFONE ---\nlet telefone = emailData.telefone || \"\";\nif (!telefone) {\n  const phonePatterns = [\n    /\\(?\\d{2}\\)?\\s?9\\d{4}[-.\\s]?\\d{4}/,\n    /\\(?\\d{2}\\)?\\s?\\d{4}[-.\\s]?\\d{4}/,\n    /\\b\\d{2}\\s?9\\d{8}\\b/,\n    /\\b\\d{2}\\s?\\d{8}\\b/\n  ];\n  for (const pattern of phonePatterns) {\n    const phoneMatch = pdfText.match(pattern);\n    if (phoneMatch) {\n      telefone = phoneMatch[0].replace(/[^\\d]/g, \"\");\n      if (telefone.length >= 10 && telefone.length <= 11) break;\n      telefone = \"\";\n    }\n  }\n}\n\n// --- NOME (fallback) ---\nlet nome_cliente = emailData.nome_cliente || \"\";\nif (!nome_cliente) {\n  const nomePatterns = [\n    /(?:nome|cliente|contratante|assinante|outorgante)[:\\s]+([A-Z\\u00C0-\\u017F][A-Z\\u00C0-\\u017Fa-z\\u00e0-\\u00ff\\s]{3,50})/i,\n    /(?:eu,?\\s+)([A-Z\\u00C0-\\u017F][A-Z\\u00C0-\\u017Fa-z\\u00e0-\\u00ff\\s]{3,50})(?:,|\\s+portador)/i\n  ];\n  for (const pattern of nomePatterns) {\n    const nomeMatch = pdfText.match(pattern);\n    if (nomeMatch) {\n      nome_cliente = nomeMatch[1].trim();\n      break;\n    }\n  }\n}\n\n// NAO extrai email do PDF - o email que aparece no contrato e do advogado, nao do cliente\n\nconst result = {\n  json: {\n    ...emailData,\n    cpf_cnpj,\n    telefone,\n    nome_cliente,\n    dados_extraidos_do_pdf: true,\n    pdf_text_preview: pdfText.substring(0, 500)\n  }\n};\n\ntry {\n  const unified = $('Unificar Dados + Anexo').item;\n  if (unified.binary) result.binary = unified.binary;\n} catch(e) {}\n\nreturn [result];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        112
      ],
